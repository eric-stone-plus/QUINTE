#!/usr/bin/env python3
"""quinte-audit — external audit of a completed QUINTE run.

Host-layer, post-protocol step: the QUINTE state machine is never touched.
Reads <run>/result.json (+ r3/cc-response.json when present), asks an
independent auditor model to audit the verdict, and writes the report as
<run>/r3/external-audit.json — an ADDITIVE artifact; result.json,
manifest.json and the hash chain are never modified.

Auditors (--auditor, default: env QUINTE_AUDITOR or "reasonix"):
  reasonix  reasonix CLI; default model deepseek-v4-pro; --effort max 写死不降档。
            留给单独使用——不进 MAGI 席位自动化的交叉审计绑定。
  omp       omp CLI(多 provider)。调用形态复刻 QUINTE adapter 已验证参数
            (-p --mode text --thinking xhigh --no-session --no-skills …,
            output TextJson);--model 原样透传,省略时用 omp 配置的默认模型。
            MAGI 席交叉审计走这里(M←deepseek、D←mimo、G←mimo,
            见 MAGI poc/route-audit.md §4)。

Usage:
  quinte-audit <run-id> [--auditor NAME] [--model NAME] [--timeout SEC]
                    [--json] [--mode {standard,paradigm}]
  quinte-audit --latest [--auditor omp --model deepseek-v4-pro]

Modes: standard audits the verdict (composition/evidence/blind spots/
actionability/rhetoric); paradigm attacks the shared methodological
framework itself (roster correlation blind spots, framework alternatives).

Exit codes: 0 audit completed (any verdict), 2 audit could not run.
"""
import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

RUNS_DIR = Path.home() / ".quinte" / "runs"
DEFAULT_REASONIX_MODEL = "deepseek-v4-pro"
DEFAULT_TIMEOUT = 600

INSTRUCTION_STANDARD = """你是一名独立外部审计师。你没有参与以下结论的产生，也不知道参与方的身份。
请对这份多模型对抗审查（QUINTE）的最终裁决做独立审计，只依据给定材料判断：

1. 组装完整性：裁决的 summary/recommendation 是否忠实覆盖残差清单？有无残差被静默丢弃或淡化？
2. 证据支撑：关键结论是否超出证据范围（无据断言、数字与残差描述矛盾）？
3. 盲区：材料语境下明显该查而未查的风险点。
4. 可执行性：required_closure 是否具体可验证，还是空话？
5. 修辞审计：裁决跟随的是证据最充分的一方，还是发言最多/语气最自信的一方？若发现文风压过证据的迹象（自信措辞替代证据引用、音量替代论证），作为 HIGH severity 的 finding 报出。

仅输出一个 JSON 对象（不要 markdown 围栏、不要前后文）：
{"verdict": "PASS" | "PASS_WITH_NOTES" | "FAIL",
 "confidence": 0.0-1.0,
 "findings": [{"kind": "composition|evidence|blind-spot|actionability|rhetoric", "severity": "HIGH|MEDIUM|LOW", "detail": "..."}],
 "summary": "三句话以内的审计结论"}
若材料本身证据不足以下判断，verdict 给 FAIL 并在 findings 里说明缺什么。"""

INSTRUCTION_PARADIGM = """你是一名独立外部审计师，任务是范式批判。不要逐条审计具体结论，而是攻击本轮多模型对抗审查（QUINTE）共享的方法论框架本身：

1. roster 相关性盲区：参与各方是否共享训练分布、工具链或数据源崇拜，使"五方对抗"实为同一视角的五次重复？指出哪些错误会被所有方同时犯下、因而在这个结构里无人可能暴露。
2. 框架层面的替代方案：若改用另一个方法论框架（不同的对抗结构、不同来源的评审者、不同的证据标准），本议题会被怎样重新提出？现行框架系统性地看不见什么？

仅输出一个 JSON 对象（不要 markdown 围栏、不要前后文）：
{"verdict": "PASS" | "PASS_WITH_NOTES" | "FAIL",
 "confidence": 0.0-1.0,
 "findings": [{"kind": "roster-correlation|framework|alternative", "severity": "HIGH|MEDIUM|LOW", "detail": "..."}],
 "summary": "三句话以内的审计结论"}
若材料本身不足以判断框架层面的问题，verdict 给 FAIL 并在 findings 里说明缺什么。"""


def resolve_run_dir(run_id: str) -> Path:
    exact = RUNS_DIR / run_id
    if exact.is_dir():
        return exact
    matches = [d for d in RUNS_DIR.iterdir() if d.name.startswith(run_id)]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise SystemExit(f"no run matching {run_id!r} under {RUNS_DIR}")
    raise SystemExit(f"ambiguous run id {run_id!r}: {[m.name[:8] for m in matches]}")


def latest_completed() -> Path:
    best = None
    for d in sorted(RUNS_DIR.iterdir()):
        if (d / "result.json").is_file():
            try:
                if json.loads((d / "result.json").read_text()).get("status") == "completed":
                    best = d
            except Exception:
                continue
    if best is None:
        raise SystemExit("no completed run found")
    return best


def build_brief(result: dict, cc_response: dict | None, instruction: str) -> str:
    residuals = result.get("residuals", [])
    lines = [
        "# 被审计材料\n",
        f"## 议题\n{result.get('question', '')}\n",
        f"## 裁决 summary\n{result.get('summary', '')}\n",
        f"## 裁决 recommendation\n{result.get('recommendation', '')}\n",
        f"## 残差清单（{len(residuals)} 条）",
    ]
    for r in residuals:
        lines.append(
            f"- [{r.get('severity')}] {r.get('id')}：{r.get('finding', '')}\n"
            f"  required_closure: {r.get('required_closure', '')}"
        )
    if cc_response:
        lines.append("\n## 对照仲裁（Counterpart）响应\n"
                     + json.dumps(cc_response, ensure_ascii=False)[:4000])
    lines.append("\n# 审计任务\n" + instruction)
    return "\n".join(lines)


def build_cmd(auditor: str, model: str | None, brief: str, run_dir: Path,
              timeout: int) -> tuple[list, int]:
    """返回 (cmd, subprocess_timeout)。各 auditor 的调用形态保持与 QUINTE adapter 一致。"""
    if auditor == "reasonix":
        cmd = ["reasonix", "-p", brief, "--output-format", "json", "--effort", "max"]
        if model != DEFAULT_REASONIX_MODEL:
            cmd[1:1] = ["--model", model]
        return cmd, timeout
    # omp:复刻 src/adapters.rs 的已验证 lane 参数,output kind TextJson(裸文本)
    cmd = ["omp", "-p", "--mode", "text"]
    if model:
        cmd += ["--model", model]
    cmd += [
        "--thinking", "xhigh",
        "--cwd", str(run_dir),
        "--no-session", "--no-skills", "--no-rules", "--no-extensions",
        "--no-lsp", "--no-pty",
        "--tools", "read,grep,glob",
        "--max-time", str(timeout),
        brief,
    ]
    # --max-time 是 omp 内部门限;外层多给 120s 让其干净退出
    return cmd, timeout + 120


def extract(auditor: str, proc: subprocess.CompletedProcess):
    """返回 (raw_text, session_id, cost_usd, usage) 或 SystemExit。"""
    if proc.returncode != 0:
        raise SystemExit(f"{auditor} failed (exit {proc.returncode}): {proc.stderr[:500]}")
    if auditor == "reasonix":
        try:
            envelope = json.loads(proc.stdout)
        except json.JSONDecodeError:
            raise SystemExit(f"reasonix returned non-JSON output: {proc.stdout[:500]}")
        if envelope.get("is_error"):
            raise SystemExit(f"reasonix error: {envelope.get('result', '')[:500]}")
        return (str(envelope.get("result", "")), envelope.get("session_id"),
                envelope.get("total_cost_usd"), envelope.get("usage"))
    # omp TextJson:stdout 即正文
    return proc.stdout, None, None, None


def main() -> int:
    ap = argparse.ArgumentParser(prog="quinte-audit",
                                 description="external audit of a completed QUINTE run")
    ap.add_argument("run_id", nargs="?", help="run id or unique prefix")
    ap.add_argument("--latest", action="store_true", help="audit the latest completed run")
    ap.add_argument("--auditor", choices=["reasonix", "omp"],
                    default=os.environ.get("QUINTE_AUDITOR", "reasonix"),
                    help="default: env QUINTE_AUDITOR or reasonix")
    ap.add_argument("--model", default=None,
                    help=f"default: {DEFAULT_REASONIX_MODEL} (reasonix) / omp configured default (omp)")
    ap.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    ap.add_argument("--mode", choices=["standard", "paradigm"], default="standard",
                    help="standard: audit the verdict; paradigm: attack the shared methodological framework")
    ap.add_argument("--json", action="store_true", help="print the audit artifact JSON to stdout")
    args = ap.parse_args()

    if args.latest:
        run_dir = latest_completed()
    elif args.run_id:
        run_dir = resolve_run_dir(args.run_id)
    else:
        ap.error("give a run id or --latest")

    result_path = run_dir / "result.json"
    if not result_path.is_file():
        raise SystemExit(f"{run_dir.name}: no result.json (run not completed?)")
    result = json.loads(result_path.read_text())
    if result.get("status") != "completed":
        raise SystemExit(f"{run_dir.name}: status={result.get('status')!r}, audit only completed runs")

    cc_path = run_dir / "r3" / "cc-response.json"
    cc_response = None
    if cc_path.is_file():
        try:
            cc_response = json.loads(cc_path.read_text())
        except Exception:
            pass

    model = args.model or (DEFAULT_REASONIX_MODEL if args.auditor == "reasonix" else None)
    instruction = INSTRUCTION_PARADIGM if args.mode == "paradigm" else INSTRUCTION_STANDARD
    brief = build_brief(result, cc_response, instruction)
    cmd, proc_timeout = build_cmd(args.auditor, model, brief, run_dir, args.timeout)

    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=proc_timeout,
                              cwd=str(run_dir) if args.auditor == "omp" else None)
    except subprocess.TimeoutExpired:
        raise SystemExit(f"{args.auditor} timed out after {proc_timeout}s")
    raw_text, session_id, cost_usd, usage = extract(args.auditor, proc)

    parsed = None
    start, end = raw_text.find("{"), raw_text.rfind("}")
    if start != -1 and end > start:
        try:
            parsed = json.loads(raw_text[start:end + 1])
        except json.JSONDecodeError:
            parsed = None

    artifact = {
        "audit_version": "1.0",
        "run_id": result.get("run_id", run_dir.name),
        "audited_at": datetime.now(timezone.utc).isoformat(),
        "auditor": f"{args.auditor}/{model or 'default'}",
        "mode": args.mode,
        "reasonix_session_id": session_id,
        "cost_usd": cost_usd,
        "usage": usage,
        "audit": parsed,
        "audit_raw": None if parsed else raw_text,
        "note": "additive artifact; result.json/manifest.json/hash chain untouched",
    }

    r3_dir = run_dir / "r3"
    r3_dir.mkdir(exist_ok=True)
    # mode-specific filename so a paradigm audit never overwrites the standard one
    out_path = r3_dir / ("external-audit.json" if args.mode == "standard"
                         else f"external-audit-{args.mode}.json")
    out_path.write_text(json.dumps(artifact, ensure_ascii=False, indent=2))

    if args.json:
        print(json.dumps(artifact, ensure_ascii=False, indent=2))
    else:
        verdict = (parsed or {}).get("verdict", "UNPARSED")
        print(f"run:      {run_dir.name}")
        print(f"mode:     {args.mode}")
        cost_str = f" (cost ${cost_usd:.4f})" if cost_usd is not None else ""
        print(f"auditor:  {args.auditor}/{model or 'default'}{cost_str}")
        print(f"verdict:  {verdict}")
        if parsed and parsed.get("summary"):
            print(f"summary:  {parsed['summary']}")
        for f in (parsed or {}).get("findings", []):
            print(f"  [{f.get('severity')}] ({f.get('kind')}) {f.get('detail', '')[:120]}")
        if not parsed:
            print("  (model output was not clean JSON — see audit_raw in artifact)")
        print(f"written:  {out_path}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        pass
