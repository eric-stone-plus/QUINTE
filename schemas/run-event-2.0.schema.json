{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eric-stone-plus/QUINTE/contracts/run-event/2.0/schema.json",
  "title": "QUINTE Finance Run Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_version",
    "run_id",
    "run_genesis_digest",
    "sequence",
    "previous_event_sha256",
    "event_kind",
    "payload"
  ],
  "properties": {
    "event_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_genesis_digest": {"$ref": "#/$defs/digest"},
    "sequence": {"$ref": "#/$defs/safe_nonnegative_integer"},
    "previous_event_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "event_kind": {
      "enum": ["run.created", "run.phase_advanced", "run.terminalized"]
    },
    "payload": {"type": "object"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_family",
        "revision",
        "exact_sha256",
        "semantic_domain",
        "semantic_sha256"
      ],
      "properties": {
        "contract_family": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "format": "uri", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "exact_sha256": {"$ref": "#/$defs/digest"},
        "semantic_domain": {"type": "string", "minLength": 1},
        "semantic_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact_identities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact_identity"}
    },
    "finance_result_identity": {
      "allOf": [
        {"$ref": "#/$defs/artifact_identity"},
        {
          "required": ["schema_id"],
          "properties": {
            "contract_family": {"const": "finance-review-result"},
            "schema_id": {
              "const": "https://github.com/eric-stone-plus/QUINTE/contracts/finance-review-result/1.0/schema.json"
            },
            "revision": {"const": "1.0"},
            "semantic_domain": {"const": "quinte.finance-review-result.v1"}
          }
        }
      ]
    },
    "active_status": {
      "enum": ["r1_running", "r2_running", "merging"]
    },
    "termination_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "retryable"],
      "properties": {
        "phase": {"$ref": "#/$defs/active_status"},
        "code": {"enum": ["output_invalid", "integrity_failure", "operator_cancelled"]},
        "retryable": {"const": false}
      }
    },
    "created_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact_bindings"],
      "properties": {
        "status": {"const": "r1_running"},
        "artifact_bindings": {
          "allOf": [
            {"$ref": "#/$defs/artifact_identities"},
            {"minItems": 7, "maxItems": 7}
          ]
        }
      }
    },
    "phase_advanced_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_status", "status", "artifact_bindings"],
      "properties": {
        "previous_status": {"$ref": "#/$defs/active_status"},
        "status": {"$ref": "#/$defs/active_status"},
        "artifact_bindings": {"$ref": "#/$defs/artifact_identities"}
      },
      "oneOf": [
        {
          "properties": {
            "previous_status": {"const": "r1_running"},
            "status": {"const": "r2_running"},
            "artifact_bindings": {"minItems": 17, "maxItems": 17}
          }
        },
        {
          "properties": {
            "previous_status": {"const": "r2_running"},
            "status": {"const": "merging"},
            "artifact_bindings": {"minItems": 24, "maxItems": 24}
          }
        }
      ]
    },
    "terminalized_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_status", "status", "artifact_bindings", "result", "termination"],
      "properties": {
        "previous_status": {"$ref": "#/$defs/active_status"},
        "status": {"enum": ["completed", "degraded", "failed", "cancelled"]},
        "artifact_bindings": {"$ref": "#/$defs/artifact_identities"},
        "result": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifact_identity"}
          ]
        },
        "termination": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/termination_facts"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["completed", "degraded"]}
            }
          },
          "then": {
            "properties": {
              "artifact_bindings": {"minItems": 25, "maxItems": 25},
              "result": {"$ref": "#/$defs/finance_result_identity"},
              "termination": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "result": {"type": "null"},
              "termination": {"$ref": "#/$defs/termination_facts"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["completed", "degraded"]}
            }
          },
          "then": {
            "properties": {
              "previous_status": {"const": "merging"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {
            "properties": {
              "termination": {
                "allOf": [
                  {"$ref": "#/$defs/termination_facts"},
                  {"properties": {"code": {"enum": ["output_invalid", "integrity_failure"]}}}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "cancelled"}}},
          "then": {
            "properties": {
              "termination": {
                "allOf": [
                  {"$ref": "#/$defs/termination_facts"},
                  {"properties": {"code": {"const": "operator_cancelled"}}}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["failed", "cancelled"]}, "termination": {"properties": {"phase": {"const": "r1_running"}}}}},
          "then": {
            "properties": {
              "previous_status": {"const": "r1_running"},
              "artifact_bindings": {"minItems": 7, "maxItems": 7}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["failed", "cancelled"]}, "termination": {"properties": {"phase": {"const": "r2_running"}}}}},
          "then": {
            "properties": {
              "previous_status": {"const": "r2_running"},
              "artifact_bindings": {"minItems": 17, "maxItems": 17}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["failed", "cancelled"]}, "termination": {"properties": {"phase": {"const": "merging"}}}}},
          "then": {
            "properties": {
              "previous_status": {"const": "merging"},
              "artifact_bindings": {"minItems": 24, "maxItems": 24}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {"const": 0}
        }
      },
      "then": {
        "properties": {
          "previous_event_sha256": {"type": "null"},
          "event_kind": {"const": "run.created"}
        }
      },
      "else": {
        "properties": {
          "previous_event_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "sequence": {"const": 0},
            "event_kind": {"const": "run.created"},
            "payload": {"$ref": "#/$defs/created_payload"}
          }
        },
        {
          "properties": {
            "sequence": {"type": "integer", "minimum": 1},
            "event_kind": {"const": "run.phase_advanced"},
            "payload": {"$ref": "#/$defs/phase_advanced_payload"}
          }
        },
        {
          "properties": {
            "sequence": {"type": "integer", "minimum": 1},
            "event_kind": {"const": "run.terminalized"},
            "payload": {"$ref": "#/$defs/terminalized_payload"}
          }
        }
      ]
    }
  ]
}
