{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eric-stone-plus/QUINTE/contracts/run-manifest/3.0/schema.json",
  "title": "QUINTE Finance Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "protocol_version",
    "run_id",
    "run_genesis_digest",
    "event_checkpoint",
    "status",
    "termination",
    "policy",
    "invocation",
    "r1_packets",
    "r2_packets",
    "r1_outputs",
    "r2_outputs",
    "arbiter_outputs",
    "result"
  ],
  "properties": {
    "manifest_version": {"const": "3.0"},
    "protocol_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_genesis_digest": {"$ref": "#/$defs/digest"},
    "event_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "status": {
      "enum": [
        "preflight",
        "r1_running",
        "r2_running",
        "merging",
        "completed",
        "degraded",
        "failed",
        "cancelled"
      ]
    },
    "termination": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/termination_facts"}
      ]
    },
    "policy": {"$ref": "#/$defs/binding"},
    "invocation": {"$ref": "#/$defs/binding"},
    "r1_packets": {"$ref": "#/$defs/up_to_five_bindings"},
    "r2_packets": {"$ref": "#/$defs/up_to_five_bindings"},
    "r1_outputs": {"$ref": "#/$defs/up_to_five_bindings"},
    "r2_outputs": {"$ref": "#/$defs/up_to_five_bindings"},
    "arbiter_outputs": {"$ref": "#/$defs/up_to_two_bindings"},
    "result": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/binding"}
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_sha256"],
      "properties": {
        "sequence": {"$ref": "#/$defs/safe_nonnegative_integer"},
        "event_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "termination_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "retryable"],
      "properties": {
        "phase": {"enum": ["r1_running", "r2_running", "merging"]},
        "code": {"enum": ["output_invalid", "integrity_failure", "operator_cancelled"]},
        "retryable": {"const": false}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "contract_family",
        "revision",
        "exact_sha256",
        "semantic_domain",
        "semantic_sha256"
      ],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1},
        "contract_family": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "format": "uri", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "exact_sha256": {"$ref": "#/$defs/digest"},
        "semantic_domain": {"type": "string", "minLength": 1},
        "semantic_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "up_to_five_bindings": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    },
    "up_to_two_bindings": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    },
    "no_result": {"type": "null"},
    "bound_result": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {
          "required": ["schema_id"],
          "properties": {
            "contract_family": {"const": "finance-review-result"},
            "schema_id": {
              "const": "https://github.com/eric-stone-plus/QUINTE/contracts/finance-review-result/1.0/schema.json"
            },
            "revision": {"const": "1.0"},
            "semantic_domain": {"const": "quinte.finance-review-result.v1"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "preflight"}}},
      "then": {
        "properties": {
          "termination": {"type": "null"},
          "r1_packets": {"maxItems": 0},
          "r2_packets": {"maxItems": 0},
          "r1_outputs": {"maxItems": 0},
          "r2_outputs": {"maxItems": 0},
          "arbiter_outputs": {"maxItems": 0},
          "result": {"$ref": "#/$defs/no_result"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "r1_running"}}},
      "then": {
        "properties": {
          "termination": {"type": "null"},
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"maxItems": 0},
          "r1_outputs": {"maxItems": 0},
          "r2_outputs": {"maxItems": 0},
          "arbiter_outputs": {"maxItems": 0},
          "result": {"$ref": "#/$defs/no_result"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "r2_running"}}},
      "then": {
        "properties": {
          "termination": {"type": "null"},
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"minItems": 5, "maxItems": 5},
          "r1_outputs": {"minItems": 5, "maxItems": 5},
          "r2_outputs": {"maxItems": 0},
          "arbiter_outputs": {"maxItems": 0},
          "result": {"$ref": "#/$defs/no_result"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "merging"}}},
      "then": {
        "properties": {
          "termination": {"type": "null"},
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"minItems": 5, "maxItems": 5},
          "r1_outputs": {"minItems": 5, "maxItems": 5},
          "r2_outputs": {"minItems": 5, "maxItems": 5},
          "arbiter_outputs": {"minItems": 2, "maxItems": 2},
          "result": {"$ref": "#/$defs/no_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["completed", "degraded"]}
        }
      },
      "then": {
        "properties": {
          "termination": {"type": "null"},
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"minItems": 5, "maxItems": 5},
          "r1_outputs": {"minItems": 5, "maxItems": 5},
          "r2_outputs": {"minItems": 5, "maxItems": 5},
          "arbiter_outputs": {"minItems": 2, "maxItems": 2},
          "result": {"$ref": "#/$defs/bound_result"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "termination": {
            "allOf": [
              {"$ref": "#/$defs/termination_facts"},
              {"properties": {"code": {"enum": ["output_invalid", "integrity_failure"]}}}
            ]
          },
          "result": {"$ref": "#/$defs/no_result"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}},
      "then": {
        "properties": {
          "termination": {
            "allOf": [
              {"$ref": "#/$defs/termination_facts"},
              {"properties": {"code": {"const": "operator_cancelled"}}}
            ]
          },
          "result": {"$ref": "#/$defs/no_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["failed", "cancelled"]},
          "termination": {"properties": {"phase": {"const": "r1_running"}}}
        }
      },
      "then": {
        "properties": {
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"maxItems": 0},
          "r1_outputs": {"maxItems": 0},
          "r2_outputs": {"maxItems": 0},
          "arbiter_outputs": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["failed", "cancelled"]},
          "termination": {"properties": {"phase": {"const": "r2_running"}}}
        }
      },
      "then": {
        "properties": {
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"minItems": 5, "maxItems": 5},
          "r1_outputs": {"minItems": 5, "maxItems": 5},
          "r2_outputs": {"maxItems": 0},
          "arbiter_outputs": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["failed", "cancelled"]},
          "termination": {"properties": {"phase": {"const": "merging"}}}
        }
      },
      "then": {
        "properties": {
          "r1_packets": {"minItems": 5, "maxItems": 5},
          "r2_packets": {"minItems": 5, "maxItems": 5},
          "r1_outputs": {"minItems": 5, "maxItems": 5},
          "r2_outputs": {"minItems": 5, "maxItems": 5},
          "arbiter_outputs": {"minItems": 2, "maxItems": 2}
        }
      }
    }
  ]
}
